# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.pytest_cache/

# DriverDNA local state and generated output (reports are regenerated, not committed)
*.db
*.blobs/
*.sqlite3
reports/
out/

# Lap-analysis protocol working area (docs/LAP-ANALYSIS-PROTOCOL.md). The blind
# digests and sealed engine output regenerate byte-identically from the
# committed fixtures, so they are derived data, not record. The record — the
# observations and the comparison — lives in docs/lap-analysis/ and IS committed.
scratch/

# Secrets — env-only, never committed (CLAUDE.md)
.env
.env.*

# AI agent tooling — the rule/settings files below are committed on purpose
# (AGENTS.md, .agents/rules/, .gemini/settings.json); only the scratch each
# tool writes beside them is ignored.
.gemini/*
!.gemini/settings.json
.antigravity/
.agents/cache/

# OS noise
.DS_Store
ui/node_modules/
